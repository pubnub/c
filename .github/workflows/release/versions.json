{
  ".pubnub.yml": [
    { "pattern": "^version: \"(.+)\"$", "cleared": true },
    { "pattern": "\/releases\/tag\/([0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?)", "cleared": true }
  ],
  "CMakeLists.txt": [
    { "pattern": "project\\(pubnub VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)", "cleared": true }
  ],
  "README.md": [
    { "pattern": "GIT_TAG\\s+([0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?)", "cleared": true }
  ]
}
